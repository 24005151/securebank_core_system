# Copy this file to .env and fill in real values before running the app.
# Generate secrets with: python3 -c "import secrets; print(secrets.token_hex(32))"

API_KEY=replace-with-a-random-hex-string
SESSION_SECRET_KEY=replace-with-a-random-hex-string

# Set to true when running behind TLS/HTTPS in production.
# Keeps session cookies secure (Secure flag on cookie).
HTTPS_ONLY=false

# ---------------------------------------------------------------------------
# Known limitations
# ---------------------------------------------------------------------------
#
# Race condition on balance (TOCTOU):
#   SQLite does not support SELECT ... FOR UPDATE row-level locking.
#   Under concurrent load, two simultaneous withdrawals from the same account
#   could both read the same balance and both succeed, resulting in an
#   overdraft. Switch to PostgreSQL and add FOR UPDATE in production.
#
# Demo passwords:
#   The seeded admin/staff1 accounts use predictable defaults (Admin123/Staff123).
#   Both are flagged must_change_password=True so the UI prompts for a change
#   on first login, but the passwords remain valid until changed.
#   Rotate them immediately after first login in any non-demo environment.
